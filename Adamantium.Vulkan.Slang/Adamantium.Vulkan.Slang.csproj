<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latestmajor</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Adamantium.Vulkan.Slang</AssemblyName>
    <RootNamespace>Adamantium.Vulkan.Slang</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Adamantium.Vulkan.Slang</PackageId>
    <Version>1.1.0</Version>
    <Description>C# bindings to the Slang shader compiler, shipping the compiler itself so that building shaders needs no Vulkan SDK installed, and Slang's language server, slangd, for editors. Slang is Apache-2.0 with the LLVM exception and carries further projects inside its binaries - see THIRD-PARTY-NOTICES.md in the repository.</Description>
    <PackageTags>slang;shader;compiler;spirv;vulkan;hlsl;lsp</PackageTags>
  </PropertyGroup>

  <!--
    Native libraries are produced by native/build.ps1 (Windows) or native/build.sh (Linux/macOS), which stage the
    slang-c-shared shim, the Slang runtime and slangd under runtimes/<rid>/native - all from one Slang build, the one in
    the Vulkan SDK. The C# interop itself is generated by QuantumBinding from native/slang_c.h into Generated/.

    The package carries runtimes/ as it is, and NuGet hands an application the folder for the platform it runs on.
    slang.dll is a 75 KB front for slang-compiler.dll on Windows; on Linux libslang.so is the compiler itself, so the
    shim links libslang-compiler.so.0.<version> and finds it beside itself ($ORIGIN). glslang carries the SPIRV-Tools
    optimizer: without it Slang silently skips optimization and emits 18% more SPIR-V. slang-rt and slang-glsl-module
    change nothing here - measured.
  -->
  <ItemGroup>
    <None Update="runtimes\**" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- A project reference does not resolve runtimes\ - only a package does - so inside this repository the current
       platform's libraries are copied next to the application, where they were before. -->
  <ItemGroup>
    <None Update="runtimes\win-x64\native\*" Condition="$([MSBuild]::IsOSPlatform('Windows'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\linux-x64\native\*" Condition="$([MSBuild]::IsOSPlatform('Linux'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\osx-x64\native\*" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuantumBinding.Utils" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
