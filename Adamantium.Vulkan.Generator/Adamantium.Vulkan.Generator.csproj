<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latestmajor</LangVersion>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="vk.xml" />
    <Content Include="vk.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="video.xml" />
    <Content Include="video.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- QuantumBinding from source or from its package: Directory.Build.props decides. -->
  <ItemGroup Condition="'$(UseQuantumBindingSource)' == 'true'">
    <ProjectReference Include="$(QuantumBindingDir)QuantumBinding.Generator\QuantumBinding.Generator.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseQuantumBindingSource)' != 'true'">
    <PackageReference Include="QuantumBinding.Generator" Version="$(QuantumBindingVersion)" />
  </ItemGroup>

</Project>
